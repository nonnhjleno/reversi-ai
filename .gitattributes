# manifestのSHA-256を保つため、Phase 0の固定資産は改行を変換しない。
/baselines/random_v0/** -text
/benchmark_sets/phase0/** -text
# 複製元から保持したCRLFと末尾空行は、固定実体の一部として扱う。
/baselines/random_v0/reversi.py whitespace=cr-at-eol,-blank-at-eof

# Phase 5の独立固定版はmanifestと同じbytesをGitでも保持する。
/baselines/search_v1/** -text

# WSL起動と学習の来歴照合でPhase 6.5ソースのbytesを再現する。
/tools/phase65_isolate.sh text eol=lf
/tools/phase65_*.py text eol=lf

# Preserve the archived positional_v1 file bytes across checkout configurations.
/baselines/positional_v1/ai_engine.py text eol=lf
/baselines/positional_v1/reversi.py text eol=crlf
/baselines/positional_v1/manifest.json text eol=crlf
